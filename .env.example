# Copia este archivo a .env.local y rellena los valores.
#   cp .env.example .env.local

# ---------------------------------------------------------------------------
# Firebase — cliente (console.firebase.google.com > Configuración del proyecto)
# Estos valores son públicos por diseño: viajan en el bundle del navegador.
# Lo que protege los datos son las reglas de Firestore, no ocultar estas claves.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin — servidor (Configuración > Cuentas de servicio > Generar clave)
# SECRETOS. Solo en Vercel / .env.local, nunca en el cliente.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ---------------------------------------------------------------------------
# Web Push (VAPID) — genera el par con:  npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto real (mailto: o https:). Los push services lo usan para avisar de
# problemas; una dirección inválida puede provocar rechazos.
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# ---------------------------------------------------------------------------
# Cron — cualquier cadena larga y aleatoria. Protege /api/cron/tick.
# El mismo valor va en el secreto CRON_SECRET de GitHub Actions.
# ---------------------------------------------------------------------------
CRON_SECRET=
