rules_version = '2';

// Reglas de Pocky.
// - Sesión obligatoria: la app inicia sesión anónima sola (src/lib/firebase.ts → ensureAuth).
//   Requiere Firebase Console → Authentication → Sign-in method → Anónimo activado.
// - El cron usa el Admin SDK, que no pasa por estas reglas.
// - Publicar: `npx firebase-tools deploy --only firestore:rules --project pocky-2c011`
//   (o pegar este archivo en Firebase Console → Firestore → Reglas → Publicar).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function inRange(v) { return v is number && v >= 0 && v <= 100; }
    function statsValid(d) {
      return inRange(d.hunger) && inRange(d.happiness) && inRange(d.cleanliness)
          && inRange(d.energy) && inRange(d.health);
    }

    match /pets/{petId} {
      allow read: if signedIn();

      allow create: if signedIn() && statsValid(request.resource.data);

      allow update: if signedIn()
        && statsValid(request.resource.data)
        // Identidad y fecha de nacimiento inmutables: ningún móvil puede reiniciar el contador de días.
        && request.resource.data.get('name', '') == resource.data.get('name', '')
        && request.resource.data.get('species', '') == resource.data.get('species', '')
        && request.resource.data.get('createdAt', 0) == resource.data.get('createdAt', 0)
        && request.resource.data.get('fcmTokens', []) is list;

      allow delete: if false;
    }
  }
}
